# ============================================
# KumBola — Environment Configuration (TEMPLATE)
# Copy to .env and fill in real values.
# NEVER commit the real .env to source control.
# ============================================

# --- Supabase project (public / client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Legacy-style JWT keys (max compatibility with supabase-js)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon-key...
SUPABASE_ANON_KEY=eyJhbGciOi...anon-key...

# --- Supabase server-only secrets (NEVER expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key...
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase Auth JWKS (for future edge/middleware JWT verification) ---
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# --- Supabase Postgres (server scripts / migrations only) ---
SUPABASE_DB_DIRECT_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
SUPABASE_DB_SESSION_POOL_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_POOL_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Prisma-style URL (points at Supabase via pooler; kept for tooling compatibility)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- App ---
NEXT_PUBLIC_APP_NAME=KumBola
NEXT_PUBLIC_APP_TAGLINE=Kum Bola: kill trash
NEXT_PUBLIC_APP_SUPPORT_EMAIL=hello@kumbola.com
NEXT_PUBLIC_APP_SUPPORT_PHONE=+233 55 000 0000
